# Copy this file to .env (never commit .env).
# Use a new, random password (32+ characters recommended).
ADMIN_USER=operator
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
CHECK_INTERVAL_SECONDS=300
FAILURE_THRESHOLD=2
RETENTION_DAYS=90

# Optional outbound incident emails (not enabled by default).
# For an SMTP service that supports STARTTLS on port 587:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
SMTP_STARTTLS=true
SMTP_SSL=false
